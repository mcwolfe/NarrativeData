@inproceedings{Galan2011442,
   author = {Galan, Nataliya and Politis, Diamanto and Gabrielsson, Jonas},
   booktitle = { : },
   institution = {University West, Division of Business Administration},
   institution = {Sten K. Johnson Centre for Entrepreneurship, Lund University (SWE)},
   institution = {School of Business, Innovation and Sustainability, Halmstad University (SWE)},
   title = {Cultivating Entrepreneurial Mindsets : Self-regulated Learning in Management Education},
   keywords = {Self-regulated learning, entrepreneurial mindset, management education; reflective diary},
   abstract = {This study explores the integration of self-regulated learning (SRL) strategies in management education to cultivate entrepreneurial mindsets among business students. Drawing on self-regulated learning theory and reflective practice, we analyze the reflective diaries of three cohorts of students enrolled in a one-year master's in Business Administration program at a Swedish university. Our findings identify two distinctive learners; guided learners, who thrive in structured and collaborative environments, and autonomous learners, who excel in independent and self-directed settings. The study highlights the dynamic transitions between these learner types, influenced by feedback internalization and task-complexity. By emphasizing the importance of reflective diaries, this research underscores the role of SRL in fostering entrepreneurial skills, enhancing student engagement, and promoting lifelong learning. The implications for business schools include the need for tailored educational approaches that support diverse learning preferences and the gradual development of students’ autonomy. Ultimately, this study contributes to the broader discourse on entrepreneurial education by demonstrating how SRL can empower students to navigate the complexities of the global business landscape with confidence and creativity.  },
   URL = {https://event.fourwaves.com/iecer2025/abstracts/10c1f10f-5031-41d5-831c-07e47497de94},
   year = {2025}
}
