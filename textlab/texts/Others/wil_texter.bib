   author = {Larsson, Lena G and B{\"a}ck-Pettersson, Siv and Kyl{\’e;}n, Sven and Marklund, Bertil and Gellerstedt, Martin and Carlstr{\"o}m, Eric},
   institution = {University West, Divison of Informatics},
   institution = {Närhälsan Kungshamn Health Centre, Region Västra Götaland, Kungshamn, Sweden; University of Gothenburg, Academy of Sahlgrenska, Institute of Medicine, Gothenburg, Sweden ; Närhälsan Research and Development Primary Health Care, Region Västra Götaland, Fyrbodal, Sweden},
