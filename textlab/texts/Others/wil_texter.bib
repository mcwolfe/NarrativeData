@inproceedings{Babaheidari685070,
   author = {Babaheidari, Said Morad and Pareto, Lena and Spante, Maria and Svensson, Lars},
   booktitle = {Proceedings IRIS 36 : August 11-14 2013 at Gran, Norway},
   institution = {University West, Divison of Informatics},
   institution = {University West, Division of Media and Design},
   pages = {461--472},
   publisher = {University of Oslo},
   title = {A Systematic Process for Selecting a Typical Case in School Setting},
   keywords = {Case Study Research, Case Selection, Purposive Selection, Whole-School Approach, IS Research Framework, WIL, Work-integrated learning, AIL},
   abstract = {This paper describes the rationale behind the concrete steps how we systematically have gone through the case selection process as the first phase of a research project named Consequences of the Digitalization of Schools. The project is a single-case longitudinal (5-year long) study and adopts a so called Whole-School Approach. Previous research has criticized case studies for lack of both systematic approach and transparency in the presentation of the case selection process. The purpose of the presentation of this case selection process is to contribute to enhancing understanding of and broadening knowledge on systematic and transparent case selection techniques. The SIRIS database has been used to select a typical Swedish primary school in the chosen municipality where the project will be conducted. The SIRIS database contains annually statistics from all primary schools in Sweden, and is available online for public use. We demonstrate how and why a particular school representing a so called typical school was selected as our case.  },
   URL = {http://www.mn.uio.no/ifi/english/research/news-and-events/events/conferences-and-seminars/iris2013/proceedings/},
   year = {2013}
}
@article{Spante1989001,
   author = {Spante, Maria and Garaway, James and Winberg, Christine and Noffemela, Fundiswa and Duma, Thulile Princess},
   institution = {University West, Divison of Informatics},
   institution = {Cape Peninsula University of Technology, Cape Town (ZAF)},
   institution = {Cape Peninsula University of Technology, Cape Town (ZAF)},
   institution = {Mangosuthu University of Technology, Durban (ZAF)},
   institution = {Mangosuthu University of Technology, Durban (ZAF)},
   journal = {International Journal of Work-Integrated Learning},
   note = {CC-BY 4.0The researchers wish to acknowledge the financial support of the National Research Foundation/South Africa-Sweden University Forum SASUF23041291642-PR-2023.},
   number = {3},
   pages = {477--491},
   publisher = {Work-Integrated Learning New Zeeland (WILNZ)},
   title = {A toolkit to enhance work-integrated learning coordinators’ understanding of practical problems},
   volume = {26},
   keywords = {work-integrated learning challenges, activity theory, systematic analysis},
   abstract = {This study is located in the area of university work-integrated learning (WIL) management, in particular the implementation of both placement and non-placement WIL. The focus of the study is on enhancing WIL coordinators’ understanding of WIL as a system, using activity theory as a framework, and to mobilize this understanding to address challenges in practice. To this end WIL coordinators at two South African universities attended WIL challenge workshops in which an activity system-derived diagnostic toolkit was introduced. The verbal discussions and diagrams presented by the coordinators were analyzed for evidence of systematic understanding of WIL, challenges and future possibilities. Findings from the study revealed that WIL coordinators successfully used the toolkit to identify system-level constraints and were inspired to engage in further investigations. The authors thus argue that the diagnostic toolkit could be used with WIL coordinators at other universities as a useful approach to understanding and optimizing their WIL practices. },
   URL = {https://www.ijwil.org/files/IJWIL_26_3_477_491.pdf},
   year = {2025}
}
@article{Truong1866519,
   author = {Truong, Anh and Winman, Thomas and Ekstr{\"o}m-Bergstr{\"o}m, Anette and Johansson, Catrin},
   institution = {University West, Section for nursing - undergraduate level},
   institution = {University West, Divison of Informatics},
   institution = {University West, Section for nursing - graduate level},
   institution = {University West, Section for health promotion and care sciences},
   institution = {School of Education and Communication, Jönköping University, Jönköping (SWE)},
   journal = {Studies in Continuing Education},
   note = {CC BY 4.0},
   number = {3},
   pages = {496--512},
   title = {A work-integrated educational intervention in health and social care : professionals’ experiences of joint education},
   volume = {47},
   DOI = {10.1080/0158037X.2024.2363261},
   keywords = {Continuous learning; healthcare; intraprofessional and interprofessional learning; professional development; work-integrated learning},
   abstract = {Worldwide, educational interventions (EI) are continuously carried out to support the development of individuals and organisations. Keeping pace with rapid changes in modern workplaces requires continuous learning on the part of professionals. The same requirement applies to professionals in the sector of health and social care. Although research has begun to identify the knowledge and competence requirements of professionals within the sector, we need more knowledge about the implementation of EIs as well as their impact on professionals’ learning in this context. Accordingly, this study aimed to explore professionals’ experience with a work-integrated learning – designed EI that combined web-based lectures and structured group reflections, with a focus on learning and the learning process. Qualitative content analysis of the interview data revealed that the work-integrated learning (WIL) design had a positive impact on individual, as well as intraprofessional and interprofessional, learning. This resulted in an understanding of the fundamentals of professionals’ learning and how it was supported or disrupted during the course of the intervention. Moreover, a sense of affirmation was shown to have an impact on professionals’ learning. These findings may constitute a meaningful contribution to the development of EIs for professionals both within this context and more generally. },
   year = {2025}
}
